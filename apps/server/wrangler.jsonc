{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ci-retro-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "RETRO_ROOM",
        "class_name": "RetroRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RetroRoom"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ci-retro-db",
      "database_id": "local-d1-placeholder",
      "migrations_dir": "migrations"
    }
  ]
}
