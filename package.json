{
  "name": "ci-retrospective",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n 'server,web' -c 'magenta,cyan' 'npm run dev:server' 'npm run dev:web'",
    "dev:web": "npm run dev --workspace=@ci-retro/web",
    "dev:server": "npm run dev --workspace=@ci-retro/server",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^5.8.2",
    "wrangler": "^4.139.0"
  }
}
